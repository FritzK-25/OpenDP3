# Build, packaging and runtime output lives at the top of the repository. Anchored,
# so a source subpackage of the same name is never silently left untracked.
/artifacts/
/data/
*.sqlite*
*.lock
!requirements.lock
.env
.env.*
config.json
ui.json
/exports/
*.log
/dist/
/build/


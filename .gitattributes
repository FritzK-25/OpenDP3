# Store and check out text as LF everywhere, so a Windows checkout hashes the
# same as Linux and the Home Assistant app copy never drifts on line endings.
* text=auto eol=lf

# Windows-only launchers keep CRLF in the working tree.
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.ico binary
*.png binary
*.exe binary
